<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id= "@+id/fragment_playlists">

    <Button
        app:backgroundTint="@color/button_background"
        android:textColor="@color/button_text"
        style="@style/new_playlist_button"
        android:id="@+id/newPlaylistButton"
        android:layout_gravity="center"
        android:text="@string/new_playlist_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </Button>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlist_library_list_recycler"
        android:layout_marginVertical="16dp"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/tracks_list_recycler_margin_top"
        android:layout_height="wrap_content">
    </androidx.recyclerview.widget.RecyclerView>
</FrameLayout>