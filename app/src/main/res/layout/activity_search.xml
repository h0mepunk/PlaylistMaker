<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/background"
    android:backgroundTint="@color/search_background">

    <Toolbar
        android:id="@+id/search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:navigationIcon="@drawable/arrow_back"
        android:title="@string/search_title"
        android:titleTextAppearance="@style/toolbar_title_text">
    </Toolbar>
    <FrameLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/inputEditText"
            style="@style/search_text_edit"
            android:background="@drawable/search_text_edit"
            android:textCursorDrawable="@drawable/color_cursor"
            android:drawableStart="@drawable/search_mini"
            android:hint="@string/input_hint"
            android:maxLength="100"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:inputType="text">
        </EditText>
        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/search_icon_margin_vertical"
            android:layout_marginRight="@dimen/search_icon_margin_right"
            android:layout_gravity="end"
            android:src="@drawable/cross_icon"
            android:visibility="visible" />

    </FrameLayout>
    <ProgressBar
        android:id="@+id/searchProgressBar"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/searchPreloaderMarginTop"
        android:indeterminateTint="@color/blue"
        android:layout_width="@dimen/progressBarSize"
        android:layout_height="@dimen/progressBarSize"
        android:visibility="gone">
    </ProgressBar>
    <TextView
        android:id="@+id/searchHistoryTitle"
        style="@style/search_history_title"
        android:text="@string/search_history_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        ></TextView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/song_list_recycler"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/tracks_list_recycler_margin_top"
        android:layout_height="wrap_content">
    </androidx.recyclerview.widget.RecyclerView>

        <Button
            android:id="@+id/clearHistoryButton"
            style="@style/clear_history_button"
            android:layout_gravity="center"
            android:text="@string/clear_history_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </Button>
    <LinearLayout
        android:id="@+id/placeholderView"
        android:layout_marginTop="@dimen/error_layout_margin_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/placeholderIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/empty_results_error">
        </ImageView>
        <TextView
            android:id="@+id/placeholderMessageText"
            style="@style/error_text"
            android:text="@string/network_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <Button
            android:id="@+id/refreshButton"
            style="@style/error_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </Button>
    </LinearLayout>
</LinearLayout>