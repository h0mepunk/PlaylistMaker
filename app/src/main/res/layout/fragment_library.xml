<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.library.LibraryFragment"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:id="@+id/library_view"
    style="@style/background"
    android:backgroundTint="@color/search_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/library_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_lib_height"
            app:title="@string/library_title"
            android:titleTextAppearance="@style/toolbar_title_text">
        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            style="@style/nav_tab"
            app:tabIndicatorFullWidth="false"
            app:tabIndicator="@drawable/tab_rectangle"
            app:tabTextAppearance="@style/tab_text_style"
            android:textAllCaps = "false"
            android:layout_width="match_parent"
            android:gravity="fill"
            app:tabIndicatorGravity="bottom"
            app:tabSelectedTextColor="@color/tabs_text_color"
            app:tabTextColor="@color/tabs_text_color"
            app:tabIndicatorColor="@color/tabs_text_color"
            app:tabIndicatorHeight="2dp"
            app:tabBackground="@color/tabs_background_color"
            android:layout_height="wrap_content"/>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</FrameLayout>