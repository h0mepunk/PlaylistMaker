<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="background">
        <item name="android:background">@color/white</item>
    </style>
    <style name="toolbar_title_text">
        <item name="android:fontFamily">"@font/ys_display_medium"</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/dark</item>
        <item name="android:titleMarginTop">@dimen/header_text_margin_top</item>
        <item name="android:titleMarginStart">@dimen/header_text_margin_start</item>
        <item name="android:textSize">@dimen/primary_text_size</item>
    </style>
    <style name="main_button_style" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">3</item>
        <item name="android:fontFamily">"@font/ys_display_medium"</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/primary_text_size</item>
        <item name="android:textColor">@color/dark</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textFontWeight">500</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/dark</item>
        <item name="android:layout_marginTop">@dimen/button_margin_top</item>
        <item name="android:layout_marginHorizontal">@dimen/button_margin_horizontal</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>
    <style name="settings_menu_item">
        <item name="android:fontFamily">"@font/ys_display_medium"</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/settings_menu_item_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/settings_menu_item_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/settings_menu_item_padding_vertical</item>
        <item name="android:textColor">@color/dark</item>
        <item name="android:textSize">@dimen/setting_item_text_size</item>
        <item name="android:thumbTint">@color/switch_thumb_color</item>
        <item name="android:trackTint">@color/switch_track_color</item>
    </style>
    <style name="search_text_edit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">19sp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/grey</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">#E6E8EB</item>
        <item name="android:layout_marginStart">@dimen/settings_menu_item_padding_horizontal</item>
    </style>
    <style name="song_title">
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:layout_marginTop">13dp</item>
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:maxLines">1</item>
        <item name="android:maxLength">30</item>
    </style>
    <style name="song_subtitle">
        <item name="android:textFontWeight">400</item>
        <item name="android:fontFamily">@font/ys_text_regular</item>
        <item name="android:textSize">11dp</item>
        <item name="android:textColor">@color/grey</item>
    </style>
    <style name="error_text">
        <item name="android:textColor">@color/dark</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/ys_text_medium</item>
    </style>
    <style name="search_history_title">
        <item name="android:textColor">@color/dark</item>
        <item name="android:textSize">19sp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/ys_text_medium</item>
    </style>
    <style name="clear_history_button">
        <item name="android:fontFamily">"@font/ys_display_medium"</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:textFontWeight">500</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/dark</item>
        <item name="android:layout_marginTop">@dimen/button_margin_top</item>
        <item name="android:layout_marginHorizontal">@dimen/button_margin_horizontal</item>
        <item name="android:backgroundTint">@color/dark</item>
    </style>
    <style name="error_button">
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/refresh_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:text">@string/refresh</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="backgroundColor">@color/dark</item>
    </style>
    <style name="media_info_element">
        <item name="android:textColor">@color/media_info_element</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ys_text_regular</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
    </style>
    <style name="media_info_value">
        <item name="android:textColor">@color/media_info_value</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ys_text_regular</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
    </style>
    <style name="media_song_title">
        <item name="maxLines">1</item>
        <item name="android:maxLength">50</item>
        <item name="android:textColor">@color/media_song_name</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/ys_text_medium</item>
    </style>
    <style name="media_song_subtitle">
        <item name="maxLines">1</item>
        <item name="android:maxLength">50</item>
        <item name="android:textColor">@color/media_song_name</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_text_medium</item>
    </style>
    <style name="media_time_text">
        <item name="maxLines">1</item>
        <item name="android:maxLength">10</item>
        <item name="android:textColor">@color/media_song_name</item>
        <item name="android:fontWeight">500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/ys_text_medium</item>
    </style>
</resources>